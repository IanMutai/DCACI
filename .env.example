# ===================================
# NCTP - National Climate Transparency Platform
# Environment Configuration
# ===================================

# Portal Service
PORTAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5440/portal
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-change-in-production

# MRV Service
MRV_DATABASE_URL=postgresql://postgres:postgres@localhost:5441/mrv
MRV_SERVICE_URL=http://localhost:3001

# NDC Service
NDC_DATABASE_URL=postgresql://postgres:postgres@localhost:5442/ndc
NDC_SERVICE_URL=http://localhost:3002

# Registry Service
REGISTRY_DATABASE_URL=postgresql://postgres:postgres@localhost:5443/registry
REGISTRY_SERVICE_URL=http://localhost:3003

# Inter-service Communication
PORTAL_WEBHOOK_URL=http://localhost:3000/api/webhooks
INTERNAL_API_KEY=your-internal-api-key-here

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email Service (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@nctp.local
