# ===================================
# NCTP Monorepo .gitignore
# ===================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
build/
dist/
.turbo/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example tracked
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma
apps/*/prisma/migrations/*/migration_lock.toml

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Vercel
.vercel

# Testing
coverage/
.nyc_output/

# Docker
docker-compose.override.yml

# Misc
*.log
*.pid
*.seed
